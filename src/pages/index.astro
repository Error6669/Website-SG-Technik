---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import AboutSection from '../components/AboutSection.astro';
import CtaBand from '../components/CtaBand.astro';
import ContactSection from '../components/ContactSection.astro';
import WinterRoad from '../components/WinterRoad.astro';
---

<BaseLayout
  title="SG Technik GmbH — Silo- und Soleanlagen für den Winterdienst"
  description="Planung, Montage, Wartung und Notdienst für Streusalz- und Soleanlagen im kommunalen Winterdienst. Robust. Präzise. Vernetzt."
>
  {/* Bezugsrahmen für die Winterdienst-Straße, die rechts an allen Abschnitten entlangläuft. */}
  <div class="relative">
    <Hero />
    <AboutSection />
    <CtaBand />
    <ContactSection />
    <WinterRoad route="startseite" />
  </div>
</BaseLayout>
