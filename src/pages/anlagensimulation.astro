---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlantSimulation from '../components/PlantSimulation.astro';
---

<BaseLayout
  title="Unsere Anlagen — SG Technik GmbH"
  description="Silo- und Soleanlage im Betrieb: Sole herstellen, umwälzen und entnehmen, Salz entnehmen und anliefern — mit Pumpen- und Ventilkasten, RFID und SalzManager."
>
  <section class="bg-fog-50 pt-[5.75rem] pb-1 sm:pt-24">
    {/* Ohne Breitenbegrenzung: Die Simulation soll fast die ganze Seite
        füllen. Wie groß sie wird, bestimmt PlantSimulation selbst aus dem
        freien Platz im Fenster; der Block aus Anlage und Knöpfen bleibt mittig. */}
    <div class="px-4 sm:px-6">
      {/* Seitenkopf im Rahmen der Simulation: beginnt an derselben linken Kante
          wie die Zeichnung. */}
      <PlantSimulation>
        <a
          href="/produkte-technik"
          class="mb-3 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.14em] text-slate-600 transition-colors hover:text-navy-800"
        >
          <span aria-hidden="true">←</span>
          Produkte &amp; Technik
        </a>
        {/* Sichtbare Überschrift auf Wunsch entfernt; für Screenreader und
            Suchmaschinen bleibt die Hauptüberschrift der Seite erhalten. */}
        <h1 class="sr-only">Unsere Anlagen im Betrieb</h1>
      </PlantSimulation>
    </div>
  </section>
</BaseLayout>
