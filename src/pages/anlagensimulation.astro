---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlantSimulation from '../components/PlantSimulation.astro';
import CtaBand from '../components/CtaBand.astro';
---

<BaseLayout
  title="Unsere Anlagen — SG Technik GmbH"
  description="Silo- und Soleanlage im Betrieb: Sole herstellen, umwälzen und entnehmen, Salz entnehmen und anliefern — mit Pumpen- und Ventilkasten, RFID und SalzManager."
>
  <section class="bg-fog-50 pt-24 pb-14 sm:pt-28 sm:pb-16">
    {/* Breiter als die übrigen Seiten (max-w-7xl statt 6xl): Die Zeichnung
        braucht die Breite, damit Beschriftungen lesbar bleiben. */}
    <div class="mx-auto max-w-7xl px-6">
      <a
        href="/produkte-technik"
        class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.14em] text-slate-600 transition-colors hover:text-navy-800"
      >
        <span aria-hidden="true">←</span>
        Produkte &amp; Technik
      </a>
      <div class="mt-5 mb-6 lg:flex lg:items-end lg:justify-between lg:gap-12">
        <h1 class="text-balance font-display text-3xl font-bold leading-tight text-navy-800 sm:text-4xl">
          Unsere Anlagen im Betrieb
        </h1>
        <p class="mt-3 max-w-xl text-base leading-relaxed text-slate-600 lg:mt-0">
          Starten Sie einen Ablauf und verfolgen Sie, welche Leitungen, Ventile und Pumpen arbeiten — und was der
          SalzManager dabei dokumentiert.
        </p>
      </div>
      <PlantSimulation />
    </div>
  </section>
  <CtaBand />
</BaseLayout>
