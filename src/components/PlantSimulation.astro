---
// Anlagensimulation: Silo- und Soleanlage im Schnitt, mit Abläufen zum
// Starten (Sole herstellen, Salz entnehmen …) und SalzManager-Bildschirm.
// Doku: docs/animationen/anlagensimulation.md.
//
// Das Markup entsteht erst im Browser (src/scripts/anlagensimulation/), die
// Stile liegen deshalb global in src/styles/anlagensimulation.css.
// Stellwerte (Mengen, Leistungen, Geometrie): src/content/anlagensimulation.ts.
//
// Auf schmalen Bildschirmen zoomt die Zeichnung auf einen Bereich; sie
// startet immer mit der ganzen Anlage (camera.ts).
import '../styles/anlagensimulation.css';

interface Props {
  /** Platz, der neben der Zeichnung im Fenster bleiben muss (Kopfzeile der
   *  Seite plus Bedienleiste), als CSS-Länge. */
  chrome?: string;
}

const { chrome = '18rem' } = Astro.props;
---

{/* Rahmen um Seitenkopf (Slot) und Simulation: auf breiten Bildschirmen genau
    so breit wie Zeichnung plus Knopfspalte und mittig — so beginnen
    Überschrift, Legende und Zeichnung an derselben linken Kante. */}
<div class="ps-frame" data-ps-frame>
  <slot />
  <div class="ps" data-plant-sim style={`--ps-chrome: ${chrome}`}>
    <noscript>
      <p class="py-10 text-base leading-relaxed text-slate-600">
        Die Anlagensimulation braucht JavaScript. Bitte aktivieren Sie es in Ihrem Browser, um die Abläufe zu
        starten.
      </p>
    </noscript>
  </div>
</div>

<script>
  import { mountPlantSimulation } from '../scripts/anlagensimulation/plant-sim';

  const root = document.querySelector<HTMLElement>('[data-plant-sim]');
  if (root) {
    mountPlantSimulation(root, {
      frame: document.querySelector<HTMLElement>('[data-ps-frame]') ?? undefined,
      fillPage: true,
    });
  }
</script>
