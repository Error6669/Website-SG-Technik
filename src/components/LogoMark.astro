---
// Animated SG Technik logo mark.
// Source: Animationen/sg-technik-logo.js (+ einbau-snippet.html) — Intro, bei dem
// sich Ring, Chevrons und Schrift aufbauen, danach der Salz-Silo-Loop. Das
// Script liegt in src/scripts/ und baut das SVG in `.sgt-logo` auf. Abweichungen
// vom Original (dort kommentiert): Der Loop ruht, während gescrollt wird; die
// ruhenden Salzkörner sind zu wenigen Pfaden zusammengefasst; der Loop wird erst
// in einer ruhigen Stelle nach dem Intro aufgebaut, das Ende des Intros meldet
// das Ereignis `sgt:intro-done`.
//
// Der äußere Kasten ist quadratisch wie die frühere 900×900-Zeichnung. Das neue
// Artwork (viewBox 410.21 × 410.07) füllt seinen Kasten randlos, das alte hatte
// Rand. Damit das fertige Logo an derselben Stelle und gleich groß steht, wird
// es so eingepasst, dass die Ringe deckungsgleich sind:
//   alt: Mittelpunkt (444.12, 442.56), Radius 425 — neu: (203, 203), Radius 200
//   → Maßstab 2.125, Versatz (12.74, 11.19) im 900er-Kasten.
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['logomark', className]}>
  <div class="sgt-logo"></div>
</div>

<script>
  import '../scripts/sg-technik-logo.js';
</script>

<style>
  .logomark {
    position: relative;
    aspect-ratio: 1;
  }
  .sgt-logo {
    position: absolute;
    left: 1.416%; /* 12.74 / 900 */
    top: 1.243%; /* 11.19 / 900 */
    width: 96.855%; /* 410.21 × 2.125 / 900 */
    /* Eigene Ebene: Das Logo wird in jedem Bild neu gezeichnet, der Rest des
       Hero (z. B. die zählenden Kennzahlen) soll dabei nicht mitgezeichnet werden. */
    will-change: transform;
  }
</style>
