---
import { navigation } from '../content/navigation';
import { hero } from '../content/site';

const { primaryCta } = hero;
const [homeItem, ...restItems] = navigation;

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
// Aktuelle Seite = gleicher Pfad. Anker-Links (/#…) sind keine eigene Seite und
// werden nicht als „aktuell" markiert.
const isCurrent = (href: string): boolean => {
  if (href.includes('#')) return false;
  const path = href.replace(/\/+$/, '') || '/';
  return path === pathname;
};
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-navy-900">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
    <a
      href={homeItem.href}
      aria-label={homeItem.label}
      data-press
      class="sg-press-icon inline-flex text-slate-300 hover:text-fog-50 lg:hidden"
    >
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M3 11.5L12 4l9 7.5M5.5 9.5V20a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1V9.5M9.5 21v-6h5v6"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </a>

    <nav class="hidden items-center gap-6 lg:flex">
      <a
        href={homeItem.href}
        aria-label={homeItem.label}
        data-press
        class="sg-press-icon inline-flex text-slate-300 hover:text-fog-50"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M3 11.5L12 4l9 7.5M5.5 9.5V20a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1V9.5M9.5 21v-6h5v6"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
      {
        restItems.map((item) => (
          <a
            href={item.href}
            data-nav-link
            data-press
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class:list={[
              'font-body text-base text-slate-300 transition-colors hover:text-fog-50',
              isCurrent(item.href) && 'is-active',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={primaryCta.href}
      data-press
      class="sg-press-cta hidden rounded-sm border border-copper-500 px-4 py-2 font-body text-sm font-semibold text-fog-50 transition-colors hover:bg-copper-600 hover:border-copper-600 lg:inline-block"
    >
      {primaryCta.label}
    </a>

    <button
      type="button"
      class="sg-press-icon sg-press-icon--box -my-1 -mr-1.5 inline-flex h-11 w-11 items-center justify-center text-fog-50 lg:hidden"
      aria-label="Menü öffnen"
      aria-expanded="false"
      data-menu-toggle
    >
      <svg width="26" height="26" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <path d="M2 5H20M2 11H20M2 17H20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav
    class="sg-mobile-menu hidden flex-col gap-1 border-t border-white/10 px-6 py-4 focus:outline-none lg:hidden"
    tabindex="-1"
    data-mobile-menu
  >
    {
      restItems.map((item) => (
        <a
          href={item.href}
          data-nav-link
          data-press
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          class:list={[
            'py-2 font-body text-base text-slate-300 hover:text-fog-50',
            isCurrent(item.href) && 'is-active',
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  // Klick-Rückmeldung in der Kopfzeile: :active greift sofort beim Drücken. Führt
  // ein Link auf eine andere Seite, bleibt danach `is-pressed` stehen, bis die neue
  // Seite da ist — man sieht, dass der Tipp angekommen ist und geladen wird. Bei
  // Sprüngen auf derselben Seite (#kontakt) erlischt es kurz danach wieder.
  // iOS Safari setzt :active nur, wenn irgendein touchstart-Listener hängt.
  document.addEventListener('touchstart', () => {}, { passive: true });

  const samePage = (a: HTMLAnchorElement): boolean =>
    a.pathname.replace(/\/+$/, '') === location.pathname.replace(/\/+$/, '') && a.hash !== '';

  document.querySelectorAll<HTMLAnchorElement>('a[data-press]').forEach((link) => {
    link.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return; // neuer Tab o. Ä.
      link.classList.add('is-pressed');
      if (samePage(link)) window.setTimeout(() => link.classList.remove('is-pressed'), 450);
    });
  });

  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');

  const isMenuOpen = () => menu?.classList.contains('flex') ?? false;

  const closeMenu = () => {
    if (!isMenuOpen()) return;
    menu?.classList.remove('flex');
    menu?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Menü öffnen');
  };

  const openMenu = () => {
    menu?.classList.add('flex');
    menu?.classList.remove('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-label', 'Menü schließen');
    // Container statt ersten Link fokussieren → kein Fokusrahmen auf „Über uns".
    (menu as HTMLElement)?.focus();
  };

  toggle?.addEventListener('click', () => {
    if (isMenuOpen()) {
      closeMenu();
      (toggle as HTMLElement).focus();
    } else {
      openMenu();
    }
  });

  // Sprung auf derselben Seite (z. B. #kontakt): Menü sofort schließen, der Sprung
  // selbst ist die Rückmeldung. Führt der Link auf eine andere Seite, bleibt das
  // Menü offen und zeigt den gedrückten Reiter, bis die neue Seite lädt.
  menu?.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (samePage(link)) closeMenu();
    });
  });

  // Zurück-Taste (Seite aus dem bfcache): Menü zu, gedrückte Zustände lösen.
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    closeMenu();
    document.querySelectorAll('[data-press].is-pressed').forEach((el) => el.classList.remove('is-pressed'));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isMenuOpen()) {
      closeMenu();
      (toggle as HTMLElement)?.focus();
    }
  });

  document.addEventListener('click', (event) => {
    if (!isMenuOpen()) return;
    const target = event.target as Node;
    if (menu?.contains(target) || toggle?.contains(target)) return;
    closeMenu();
  });

  // -----------------------------------------------------------------------
  // Aktuellen Standort im Menü markieren: echte Seite über den Pfad, Anker-
  // Abschnitte der Startseite (Über uns, Kontakt) über Hash UND Scroll-Position.
  // -----------------------------------------------------------------------
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));

  if (navLinks.length) {
    const parse = (href: string) => {
      const u = new URL(href, location.origin);
      return { path: u.pathname.replace(/\/+$/, '') || '/', hash: u.hash };
    };
    const curPath = () => location.pathname.replace(/\/+$/, '') || '/';

    const markActive = (isActive: (h: { path: string; hash: string }) => boolean) => {
      navLinks.forEach((a) => {
        const on = isActive(parse(a.getAttribute('href') || ''));
        a.classList.toggle('is-active', on);
        if (on) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      });
    };

    const updateByLocation = () => {
      const path = curPath();
      const hash = location.hash;
      if (hash) markActive((h) => h.path === path && h.hash === hash);
      else markActive((h) => h.path === path && !h.hash);
    };

    updateByLocation();
    window.addEventListener('hashchange', updateByLocation);

    // Scroll-Spy für die Anker-Abschnitte der Startseite.
    if (curPath() === '/') {
      const seen = new Set<string>();
      const sections: { hash: string; el: Element }[] = [];
      navLinks.forEach((a) => {
        const h = parse(a.getAttribute('href') || '');
        if (h.path !== '/' || !h.hash || seen.has(h.hash)) return;
        seen.add(h.hash);
        const el = document.querySelector(h.hash);
        if (el) sections.push({ hash: h.hash, el });
      });

      if (sections.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const match = sections.find((s) => s.el === entry.target);
              if (match) markActive((h) => h.path === '/' && h.hash === match.hash);
            });
          },
          { rootMargin: '-45% 0px -50% 0px', threshold: 0 },
        );
        sections.forEach((s) => io.observe(s.el));
      }
    }
  }
</script>

<style>
  /* Menü-Hintergrund einen Tick heller als die navy-900-Kopfzeile (tunbar: %-Wert). */
  .sg-mobile-menu {
    background: color-mix(in srgb, var(--color-navy-800) 30%, var(--color-navy-900));
  }

  /* Aktueller Standort (Seite oder Abschnitt): heller + fetter. */
  [data-nav-link].is-active {
    color: var(--color-fog-50);
    font-weight: 600;
  }

  /* --- Klick-Rückmeldung: NUR die Farbe wird Kupfer — kein Rahmen, keine
     Fläche, keine Bewegung. Bei Links auf andere Seiten bleibt sie (is-pressed),
     bis die neue Seite da ist. Der Menü-Button bleibt Kupfer, solange das Menü
     offen ist. --- */
  [data-press],
  [data-menu-toggle] {
    -webkit-tap-highlight-color: transparent;
    transition: color 0.15s ease;
  }
  /* Kein Fokusrahmen nach Maus-/Fingerklick; Tastatur (:focus-visible) behält ihn. */
  [data-press]:focus:not(:focus-visible),
  [data-menu-toggle]:focus:not(:focus-visible) {
    outline: none;
  }
  /* Der Menü-Container bekommt beim Öffnen den Fokus (Tastatur/Screenreader),
     ist selbst aber kein Bedienelement → nie ein Rahmen (Safari zeichnete sonst
     einen kupfernen Strich zwischen Kopfzeile und Menü). */
  [data-mobile-menu]:focus,
  [data-mobile-menu]:focus-visible {
    outline: none;
  }

  /* Home: 40-px-Tippfläche per Innenabstand + Negativrand, Layout bleibt gleich. */
  .sg-press-icon:not(.sg-press-icon--box) {
    padding: 0.5rem;
    margin: -0.5rem;
  }

  [data-press]:active,
  [data-press].is-pressed,
  [data-nav-link][data-press]:active,
  [data-nav-link][data-press].is-pressed,
  [data-menu-toggle]:active,
  [data-menu-toggle][aria-expanded='true'] {
    color: var(--color-copper-500);
  }

  /* „Ihr Draht zu uns": Schrift bleibt hell, nur der Rahmen-Button füllt sich kupfern. */
  .sg-press-cta {
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }
  .sg-press-cta:active,
  .sg-press-cta.is-pressed {
    color: var(--color-fog-50);
    background-color: var(--color-copper-600);
    border-color: var(--color-copper-600);
  }
</style>
