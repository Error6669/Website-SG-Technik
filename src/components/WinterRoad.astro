---
// Winterdienst-Straße am rechten Rand der Startseite: Ein Räumfahrzeug fährt
// beim Scrollen eine verschneite Straße entlang, räumt und streut Salz.
// Doku: docs/animationen/winterdienst-strasse.md.
//
// Die Komponente muss in einem Element mit `position: relative` liegen, das
// alle Abschnitte umschließt, an denen die Straße vorbeiführt. Sie legt sich
// als Streifen an dessen rechten Rand. Der Verlauf wird aus den mit
// `data-wd-anchor` markierten Stellen der Seite berechnet, je Seite in einer
// eigenen Datei: `route="startseite"` → src/scripts/winterdienst/route.ts,
// `route="leistungen"` → route-leistungen.ts. Die Stellwerte des Effekts
// stehen in src/content/winterdienst.ts.
//
// Reine Zierde: für Screenreader ausgeblendet, fängt keine Klicks ab. Unter
// 1360 px Breite ist rechts neben dem Inhalt kein Platz, dort wird weder
// gezeichnet noch etwas geladen. Dasselbe gilt bei „Bewegung reduzieren“.
// Der Schalter in der Kopfzeile nimmt Straße und Fahrzeug ganz weg (Klasse
// fx-off-road am <html>, Ereignis sg:fx) und baut sie beim Einschalten neu auf.
//
// Zum Einstellen: `?wd-debug` in der Adresse zeichnet den Pfad mit allen
// Punkten ein, `?wd-p=0.5` stellt das Fahrzeug auf 50 % der Strecke (nur ohne
// Scrollen sinnvoll).
interface Props {
  route: 'startseite' | 'leistungen';
}

const { route } = Astro.props;
---

<div class="wd-road" data-winter-road={route} aria-hidden="true"></div>

<script>
  const root = document.querySelector<HTMLElement>('[data-winter-road]');
  const wide = window.matchMedia('(min-width: 85rem)');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
  const isOff = (): boolean => document.documentElement.classList.contains('fx-off-road');
  let started = false;
  let road: { destroy(): void } | null = null;
  let wheel = false;

  /** Nimmt Straße, Fahrzeug und Baumschatten wieder aus der Seite. */
  const unmount = (): void => {
    road?.destroy();
    road = null;
    root?.querySelector('.wd-canopy-canvas')?.remove();
    root?.classList.remove('is-ready');
    started = false;
  };

  // Läuft oben im Bild das Intro des Logos, wartet der Aufbau der Szene, bis es
  // fertig ist: Beides zugleich ließ das Intro auf schwachen Rechnern ruckeln.
  // Wer vorher scrollt, bekommt die Straße sofort; spätestens nach INTRO_WAIT
  // geht es ohnehin los.
  const INTRO_WAIT = 2600;
  const afterLogoIntro = (): Promise<void> =>
    new Promise((resolve) => {
      const logo = document.querySelector('.sgt-logo:not([data-intro="false"])');
      if (!logo || window.scrollY > window.innerHeight / 2) return resolve();
      const done = (): void => {
        clearTimeout(timer);
        document.removeEventListener('sgt:intro-done', done);
        window.removeEventListener('scroll', done);
        resolve();
      };
      const timer = setTimeout(done, INTRO_WAIT);
      document.addEventListener('sgt:intro-done', done);
      window.addEventListener('scroll', done, { passive: true });
    });

  const start = async (): Promise<void> => {
    if (started || !root || !wide.matches || calm.matches || isOff()) return;
    started = true;
    const [{ mountWinterRoad }, { planRoute }, { WINTER_ROAD }] = await Promise.all([
      import('../scripts/winterdienst/winter-road'),
      root.dataset.winterRoad === 'leistungen'
        ? import('../scripts/winterdienst/route-leistungen')
        : import('../scripts/winterdienst/route'),
      import('../content/winterdienst'),
      afterLogoIntro(),
    ]);
    const params = new URLSearchParams(location.search);
    // Führt die Straße durch ein Waldfoto (data-wd-forest), ragen dort Bäume
    // über die Fahrbahn (siehe canopy.ts).
    const forest = document.querySelector<HTMLImageElement>('img[data-wd-forest]');
    const canopy = forest
      ? (await import('../scripts/winterdienst/canopy')).mountCanopy(
          root,
          forest,
          document.querySelector<HTMLElement>('[data-wd-shade]'),
        )
      : null;
    const mounted = await mountWinterRoad(root, WINTER_ROAD, {
      layout: (size) => planRoute(root, size),
      debug: params.has('wd-debug'),
      onBuild: canopy ? (path, width) => void canopy(path, width).catch(() => undefined) : undefined,
    });
    road = mounted;
    // Während des Aufbaus abgeschaltet: gleich wieder weg.
    if (isOff()) return unmount();
    const fixed = params.get('wd-p');
    if (fixed) mounted.setProgress(Number(fixed));
    // Nur Safari: Mausrad-Rasten weich ausrollen, sonst springt die Seite samt
    // Fahrzeug je Raste (siehe smooth-wheel.ts). `?wd-wheel=off` zum Vergleich.
    // Nur einmal einhängen; ohne Straße (is-ready fehlt) gibt es von selbst nach.
    const safari = /^((?!chrome|chromium|crios|fxios|android).)*safari/i.test(navigator.userAgent);
    if (safari && !wheel && params.get('wd-wheel') !== 'off') {
      wheel = true;
      const { smoothWheel } = await import('../scripts/winterdienst/smooth-wheel');
      smoothWheel(() => wide.matches && root.classList.contains('is-ready'));
    }
    // Nachgeladene Schriften verschieben Textkanten, ohne dass sich die Höhe
    // der Seite ändern muss.
    document.fonts.ready.then(() => void (road === mounted && mounted.rebuild()));
  };

  // Aufbau und Abbau laufen nacheinander, nie gleichzeitig: Wer schnell aus-
  // und wieder einschaltet, bekommt sonst zwei Straßen übereinander.
  // Ohne Straße bleibt die Seite vollständig, ein Fehler hier darf nichts stören.
  let queue = Promise.resolve();
  const enqueue = (job: () => void | Promise<void>): void => {
    queue = queue.then(job).catch(() => root?.classList.remove('is-ready'));
  };
  const run = (): void => enqueue(start);
  run();
  wide.addEventListener('change', run);
  document.addEventListener('sg:fx', (e) => {
    const { name, on } = (e as CustomEvent<{ name: string; on: boolean }>).detail;
    if (name === 'road') enqueue(on ? start : unmount);
  });
</script>

<style is:global>
  /* Streifen am rechten Rand, so hoch wie der umschließende Bereich. Er reicht
     vom Bildschirmrand 12rem in die Inhaltsspalte (72rem breit, 1.5rem
     Innenabstand) hinein, damit der Schwenk zur Seitenmitte Platz hat. Der
     Hintergrund bleibt frei, es scheint durch, was dahinter liegt. */
  .wd-road {
    display: none;
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: calc(50% - 22.5rem);
    z-index: 1;
    /* clip statt hidden: hidden würde den Streifen zum Scroll-Container machen
       und das am Bildschirm festgehaltene Fahrzeug (sticky) aushebeln. */
    overflow: clip;
    pointer-events: none;
  }

  @media (min-width: 85rem) and (prefers-reduced-motion: no-preference) {
    .wd-road {
      display: block;
    }
  }

  @media print {
    .wd-road {
      display: none;
    }
  }

  /* Per Schalter in der Kopfzeile abgeschaltet. Bäume über der Straße gehören
     zum Waldbild und fallen mit ihm weg. */
  .fx-off-road .wd-road,
  .fx-off-forest .wd-canopy-canvas {
    display: none;
  }

  /* Ebene 1: die Straße in voller Länge. Liegt fest in der Seite und scrollt
     mit ihr. */
  .wd-road-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Ebene 2: das Fahrzeug, ebenfalls fest in der Seite. Schatten, Karosserie
     und Schild als einzelne Bilder, darüber die Zeichenfläche für fliegenden
     Schnee und Salz; Lage und Drehung setzt das Skript in jedem Bild. */
  .wd-sprites {
    position: absolute;
    inset: 0;
  }

  .wd-sprite {
    position: absolute;
    top: 0;
    left: 0;
    will-change: transform;
  }

  .wd-sprite > * {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Größe und Lage setzt das Skript. */
  .wd-rig-canvas {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    will-change: transform;
  }

  /* Ebene 3: überhängende Baumkronen, über Straße und Fahrzeug. Nur so hoch
     wie das Waldfoto; Lage setzt das Skript. */
  .wd-canopy-canvas {
    position: absolute;
    left: 0;
    width: 100%;
    display: block;
    z-index: 1;
  }

  .wd-road-canvas,
  .wd-sprites,
  .wd-rig-canvas,
  .wd-canopy-canvas {
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .wd-road.is-ready .wd-road-canvas,
  .wd-road.is-ready .wd-sprites,
  .wd-road.is-ready .wd-rig-canvas,
  .wd-road.is-ready .wd-canopy-canvas {
    opacity: 1;
  }
</style>
