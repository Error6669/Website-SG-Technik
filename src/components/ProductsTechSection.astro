---
import { productCategories } from '../content/produkteTechnik';

const dtClass = 'font-mono text-xs uppercase tracking-[0.1em] text-slate-600';
---

<section id="produkte-technik" class="scroll-mt-24 bg-fog-50 pt-[4.75rem] lg:pt-24">
  <h1 class="sr-only">Produkte und Technik — Silo-, Sole- und Automatisierungssysteme</h1>

  {/* MOBILE: schlanke, klebende Produktnamen-Leiste (nur Namen, links-rechts wischbar) */}
  <div class="pt-mbar lg:hidden">
    <ol class="pt-mnav">
      <li class="pt-mnav__spacer" aria-hidden="true"></li>
      {
        productCategories.map((c, i) => (
          <li class:list={['pt-mnav__item', i === 0 && 'is-active']} data-mnav={c.slug}>
            <button
              type="button"
              class="pt-mnav__btn font-display"
              data-mgoto={c.slug}
              aria-label={`${c.name} anzeigen`}
            >
              <span class="pt-mnav__index font-mono tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <span class="pt-mnav__label">{c.name}</span>
            </button>
          </li>
        ))
      }
      <li class="pt-mnav__spacer" aria-hidden="true"></li>
    </ol>
  </div>

  <div class="mx-auto max-w-6xl px-6">
    {/* MOBILE: nur das aktive Produkt (Specs → Text), normal in der Seite */}
    <div class="pt-mstage lg:hidden">
      {
        productCategories.map((c, i) => (
          <div class:list={['pt-mcat', i === 0 && 'is-shown']} data-mcat={c.slug}>
            <h2 class="sr-only">{c.name}</h2>
            {c.specs.length > 0 && (
              <dl class="pt-mspecs">
                {c.specs.map((s) => (
                  <div class="pt-mspecs__row">
                    <dt class={dtClass}>{s.label}</dt>
                    <dd class="mt-1 break-words text-sm leading-relaxed text-navy-900">{s.value}</dd>
                  </div>
                ))}
              </dl>
            )}
            <div class="space-y-4 text-base leading-relaxed text-slate-600 text-justify hyphens-auto">
              <p>{c.intro}</p>
              {c.paragraphs.map((t) => (
                <p>{t}</p>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    {/* DESKTOP: zweispaltig — links Umschalter, rechts der aktive Text (eigener Scrollbereich) */}
    <div class="pt-desk hidden lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-10 xl:gap-16">
      {/* RECHTS (order-2): nur der aktive Kategorie-Text */}
      <div class="pt-stream lg:order-2">
        {
          productCategories.map((c, i) => (
            <div class:list={['pt-cat pt-2 pb-14 sm:pb-16', i === 0 && 'is-shown']} data-cat={c.slug} id={`cat-${c.slug}`}>
              <div class="pt-inner">
                <div class="space-y-4 text-base leading-relaxed text-slate-600 text-justify hyphens-auto">
                  <p>{c.intro}</p>
                  {c.paragraphs.map((t) => (
                    <p>{t}</p>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>

      {/* LINKS (order-1): Übersicht (Kategorie-Umschalter), oben startend */}
      <aside class="pt-panel lg:order-1">
        <div class="sticky top-24">
          <p class="mb-5 flex items-center gap-3 font-mono text-xs uppercase tracking-[0.14em] text-slate-600">
            <span class="inline-block h-px w-6 bg-copper-500"></span>
            Produkte &amp; Technik
          </p>
          <ol class="pt-switch border-t border-line">
            {
              productCategories.map((c, i) => (
                <li class:list={['pt-switch__item border-b border-line', i === 0 && 'is-active']} data-target={c.slug}>
                  <button type="button" class="pt-switch__name" data-goto={c.slug} aria-label={`Zu ${c.name} springen`}>
                    <span class="pt-switch__index font-mono text-xs tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                    <span class="pt-switch__label font-display text-xl font-semibold">{c.name}</span>
                  </button>
                  <div class="pt-switch__wrap">
                    <div class="pt-switch__info">
                      <p class="text-sm leading-relaxed text-slate-600">{c.tagline}</p>
                      {c.specs.length > 0 && (
                        <dl class="mt-3 divide-y divide-line border-t border-line">
                          {c.specs.map((s) => (
                            <div class="py-2.5">
                              <dt class={dtClass}>{s.label}</dt>
                              <dd class="mt-1 break-words text-sm leading-relaxed text-navy-900">{s.value}</dd>
                            </div>
                          ))}
                        </dl>
                      )}
                    </div>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </aside>
    </div>

    {/* OHNE JAVASCRIPT: Umschalter funktionieren nicht → alle Produkte untereinander.
        Die interaktiven Ansichten blendet die <noscript>-Regel in BaseLayout aus. */}
    <noscript>
      <div class="divide-y divide-line border-t border-line pb-16">
        {
          productCategories.map((c, i) => (
            <div class="py-10 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-10 xl:gap-16">
              <div>
                <p class="font-mono text-xs tabular-nums text-slate-600">{String(i + 1).padStart(2, '0')}</p>
                <h2 class="mt-1 font-display text-xl font-semibold text-navy-900">{c.name}</h2>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">{c.tagline}</p>
                {c.specs.length > 0 && (
                  <dl class="mt-3 divide-y divide-line border-t border-line">
                    {c.specs.map((s) => (
                      <div class="py-2.5">
                        <dt class={dtClass}>{s.label}</dt>
                        <dd class="mt-1 break-words text-sm leading-relaxed text-navy-900">{s.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}
              </div>
              <div class="mt-6 space-y-4 text-base leading-relaxed text-slate-600 text-justify hyphens-auto lg:mt-0">
                <p>{c.intro}</p>
                {c.paragraphs.map((t) => (
                  <p>{t}</p>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </noscript>
  </div>
</section>

<style>
  :where(.pt-stream, .pt-panel) {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* Höhe der mobilen Namensleiste — ein Ort zum Feintunen. */
  .pt-mbar {
    --pt-bar-h: 4.25rem;
  }

  /* --- Mobile: schlanke, klebende Produktnamen-Leiste --- */
  .pt-mbar {
    position: sticky;
    top: 4.75rem; /* direkt unter der fixierten Kopfzeile */
    z-index: 20;
    height: var(--pt-bar-h);
    background: color-mix(in srgb, var(--color-slate-500) 10%, var(--color-fog-50));
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .pt-mnav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    /* Kein Snapping — sonst würde der letzte Reiter beim Loslassen immer in die
       Mitte zurückgezogen und ließe sich nicht frei nach links schieben. */
    scroll-snap-type: none;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }
  .pt-mnav::-webkit-scrollbar {
    display: none;
  }
  /* Echte Spacer (zuverlässiger als ::before/::after), damit auch das erste und
     das letzte Element mittig in die Leiste gefahren werden können. */
  .pt-mnav__spacer {
    /* Startwert; per JS exakt auf „erster/letzter Reiter mittig" gesetzt. */
    flex: 0 0 45vw;
    align-self: stretch;
    pointer-events: none;
  }
  .pt-mnav__item {
    flex: 0 0 auto;
    scroll-snap-align: center;
  }
  .pt-mnav__btn {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.35rem 0;
    white-space: nowrap;
    cursor: pointer;
  }
  .pt-mnav__index {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--color-copper-500);
  }
  .pt-mnav__label {
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-slate-500);
    /* Senkrechter Trennstrich zwischen Nummer und Text — so hoch wie die
       Textzeile, skaliert automatisch mit (aktiv = größer). */
    border-left: 1px solid var(--color-line);
    padding-left: 0.4rem;
    transition:
      color 0.2s ease,
      font-size 0.2s ease;
  }
  /* Aktuell ausgewähltes Produkt größer + kupfern. */
  .pt-mnav__item.is-active .pt-mnav__label {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-copper-600);
  }
  .pt-mnav__item.is-active .pt-mnav__index {
    color: var(--color-copper-600);
  }
  .pt-mnav__btn:focus-visible {
    outline: 2px solid var(--color-copper-500);
    outline-offset: 2px;
  }

  /* --- Mobile: nur das aktive Produkt, steht normal in der Seite --- */
  .pt-mcat {
    display: none;
  }
  .pt-mcat.is-shown {
    display: block;
    padding-top: 1.25rem;
    padding-bottom: 2rem;
  }
  .pt-mspecs {
    margin: 0 0 1.5rem;
    border-top: 1px solid var(--color-line);
  }
  .pt-mspecs__row {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  /* --- Desktop: nur der aktive Kategorie-Text --- */
  .pt-inner {
    max-width: 44rem;
    margin-inline: auto;
  }
  .pt-cat {
    display: none;
  }
  .pt-cat.is-shown {
    display: block;
  }
  /* Desktop: nur der aktive Text, eigener Scrollbereich. */
  @media (min-width: 1024px) {
    .pt-stream {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      height: calc(100vh - 6rem);
      overflow-y: auto;
      scrollbar-width: thin;
      /* Versatz, damit der Textanfang auf Höhe des ersten Listeneintrags „01" liegt. */
      padding-top: 2.75rem;
    }
  }

  /* --- Desktop-Panel: Überschriften größer + orange --- */
  .pt-switch__item {
    padding-inline: 0.85rem;
    margin-inline: -0.85rem;
    border-radius: 2px;
  }
  .pt-switch__name {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    width: 100%;
    padding: 0.85rem 0;
    text-align: left;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }
  .pt-switch__item.is-active .pt-switch__name {
    opacity: 1;
  }
  .pt-switch__index {
    color: var(--color-copper-500);
  }
  .pt-switch__label {
    line-height: 1.2;
    color: var(--color-copper-500);
    position: relative;
  }
  .pt-switch__item.is-active .pt-switch__label {
    color: var(--color-copper-600);
  }
  .pt-switch__name:focus-visible {
    outline: 2px solid var(--color-copper-500);
    outline-offset: 2px;
  }
  .pt-switch__item.is-active .pt-switch__label::before {
    content: '';
    position: absolute;
    left: -0.75rem;
    top: 0.15em;
    bottom: 0.15em;
    width: 2px;
    background: var(--color-copper-500);
  }
  .pt-switch__wrap {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.4s var(--ease-out),
      opacity 0.3s ease;
  }
  .pt-switch__wrap > .pt-switch__info {
    overflow: hidden;
    min-height: 0;
  }
  .pt-switch__item.is-active .pt-switch__wrap {
    grid-template-rows: 1fr;
    opacity: 1;
    padding-bottom: 0.9rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .pt-switch__wrap {
      transition: opacity 0.2s ease;
    }
  }
</style>

<script>
  // -------------------------------------------------------------------------
  // Desktop: rechts der aktive Kategorie-Text in einem eigenen Scrollbereich,
  //          links der Umschalter. Scrollen läuft durch Text und Seite, das
  //          Produkt wechselt nur per Klick.
  // Mobile:  oben schlanke, klebende Namensleiste, darunter das aktive Produkt
  //          (Specs → Text) normal in der Seite. Wechsel nur per Antippen.
  // -------------------------------------------------------------------------
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Desktop-Umschalter + Textblöcke.
  const switchItems = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('.pt-switch__item').forEach((li) => {
    switchItems.set(li.dataset.target!, li);
  });
  const catBlocks = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('.pt-cat').forEach((b) => catBlocks.set(b.dataset.cat!, b));

  // Mobile-Namensleiste + Produkt-Blöcke.
  const navItems = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('.pt-mnav__item').forEach((li) => navItems.set(li.dataset.mnav!, li));
  const mCats = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('.pt-mcat').forEach((b) => mCats.set(b.dataset.mcat!, b));
  const nav = document.querySelector<HTMLElement>('.pt-mnav');

  // Aktiven Namen in der mobilen Leiste exakt mittig fahren (auf Desktop No-Op,
  // da versteckt). Zweiter Lauf nach dem Größer-Werden (font-size-Übergang des
  // aktiven Reiters), damit die Breite final gemessen und sauber zentriert wird.
  const centerNav = (slug: string) => {
    const li = navItems.get(slug);
    if (!li || !nav || nav.offsetParent === null) return;
    const doCenter = () => {
      const left = li.offsetLeft - (nav.clientWidth - li.clientWidth) / 2;
      nav.scrollTo({ left, behavior: reduceMotion ? 'auto' : 'smooth' });
    };
    doCenter();
    window.setTimeout(doCenter, 240);
  };

  // Aktive (vergrößerte) Breite eines Reiters messen — Transition kurz aus, damit
  // sofort die Endbreite gemessen wird, nicht ein Zwischenwert.
  const activeWidth = (li: HTMLElement): number => {
    const label = li.querySelector<HTMLElement>('.pt-mnav__label');
    const prevT = label?.style.transition ?? '';
    if (label) label.style.transition = 'none';
    const was = li.classList.contains('is-active');
    if (!was) li.classList.add('is-active');
    const w = li.getBoundingClientRect().width;
    if (!was) li.classList.remove('is-active');
    if (label) label.style.transition = prevT;
    return w;
  };

  // Spacer exakt so breit, dass der erste bzw. letzte Reiter GENAU mittig steht —
  // nicht breiter (sonst ließe es sich zu weit ins Leere schieben).
  const sizeSpacers = () => {
    if (!nav || nav.offsetParent === null) return;
    const items = Array.from(navItems.values());
    if (!items.length) return;
    const navW = nav.clientWidth;
    const spacers = nav.querySelectorAll<HTMLElement>('.pt-mnav__spacer');
    if (spacers[0]) spacers[0].style.flexBasis = `${Math.max(0, (navW - activeWidth(items[0])) / 2)}px`;
    if (spacers[1])
      spacers[1].style.flexBasis = `${Math.max(0, (navW - activeWidth(items[items.length - 1])) / 2)}px`;
    if (lastActive) centerNav(lastActive);
  };
  if (nav) {
    requestAnimationFrame(sizeSpacers);
    window.addEventListener('resize', sizeSpacers);
    document.fonts?.ready.then(sizeSpacers);
  }

  let lastActive = '';
  const setActive = (slug: string) => {
    if (slug === lastActive) return;
    lastActive = slug;
    switchItems.forEach((li, s) => li.classList.toggle('is-active', s === slug));
    navItems.forEach((li, s) => li.classList.toggle('is-active', s === slug));
    catBlocks.forEach((b, s) => b.classList.toggle('is-shown', s === slug));
    mCats.forEach((b, s) => b.classList.toggle('is-shown', s === slug));
    centerNav(slug);
  };

  const firstSlug = document.querySelector<HTMLElement>('.pt-cat')?.dataset.cat;
  if (firstSlug) {
    setActive(firstSlug);

    const stream = document.querySelector<HTMLElement>('.pt-stream');
    const section = document.getElementById('produkte-technik');
    const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;

    // Gemeinsame Slide-Animation: aktueller Block fährt raus, danach neuer rein.
    const animateSwap = (
      blocks: Map<string, HTMLElement>,
      fromSlug: string,
      toSlug: string,
      dir: number,
      dist: number,
      dur: number,
      afterHide: () => void,
    ) => {
      const cur = blocks.get(fromSlug);
      if (cur && !reduceMotion) {
        cur.style.transition = `transform ${dur}ms ease, opacity ${dur}ms ease`;
        cur.style.transform = `translateY(${dir > 0 ? -dist : dist}px)`;
        cur.style.opacity = '0';
      }
      window.setTimeout(
        () => {
          if (cur) {
            cur.style.transition = '';
            cur.style.transform = '';
            cur.style.opacity = '';
          }
          setActive(toSlug);
          afterHide();
          const nxt = blocks.get(toSlug);
          if (nxt && !reduceMotion) {
            nxt.style.transition = 'none';
            nxt.style.transform = `translateY(${dir > 0 ? dist * 0.5 : -dist * 0.5}px)`;
            nxt.style.opacity = '0';
            requestAnimationFrame(() => {
              nxt.style.transition = `transform ${dur}ms ease, opacity ${dur}ms ease`;
              nxt.style.transform = '';
              nxt.style.opacity = '';
              window.setTimeout(() => (nxt.style.transition = ''), dur + 30);
            });
          }
        },
        reduceMotion ? 0 : dur,
      );
    };

    // Seite so weit scrollen, dass der Produktbereich oben unter der Kopfzeile
    // beginnt — nur zurück nach oben, falls man schon darunter ist (nie nach unten
    // ziehen, wenn man noch über dem Bereich steht).
    const scrollToSectionTop = () => {
      if (!section) return;
      if (section.getBoundingClientRect().top < 0) {
        section.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      }
    };

    // ---------------------------------------------------------------------
    // Desktop: Umschalten NUR per Klick. Scrollen (Mausrad/Touchpad) bewegt
    //   • runter: zuerst den Text bis zu seinem Ende, dann die Seite (Fußzeile);
    //   • rauf:   zuerst die Seite zurück bis zum Bereichsanfang, dann den Text.
    // Egal, ob der Zeiger über dem Text oder über der Übersicht steht. Passt der
    // Text in den Bereich, scrollt sofort die Seite. Strg/Zoom-Gesten und
    // seitliches Scrollen bleiben unberührt.
    // ---------------------------------------------------------------------
    if (stream && section) {
      // Mausrad im Zeilen-/Seitenmodus (Firefox) in Pixel umrechnen.
      const pixels = (e: WheelEvent) =>
        e.deltaMode === 1 ? e.deltaY * 16 : e.deltaMode === 2 ? e.deltaY * stream.clientHeight : e.deltaY;

      section.addEventListener(
        'wheel',
        (e) => {
          if (!isDesktop() || e.ctrlKey || Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
          const dy = pixels(e);
          const textLeft = stream.scrollHeight - stream.clientHeight - stream.scrollTop;
          const pageAbove = section.getBoundingClientRect().top < -1; // Seite schon über den Bereich hinaus

          if (dy > 0 && textLeft > 1 && !pageAbove) {
            e.preventDefault();
            stream.scrollTop += dy;
          } else if (dy < 0 && pageAbove) {
            // Erst die Seite zurück, auch wenn der Zeiger über dem Text steht.
            e.preventDefault();
            window.scrollBy(0, Math.max(dy, section.getBoundingClientRect().top));
          } else if (dy < 0 && stream.scrollTop > 0) {
            e.preventDefault();
            stream.scrollTop += dy;
          }
          // sonst: Seite scrollt nativ (Text zu Ende bzw. ganz oben).
        },
        { passive: false },
      );

      // Klick in der Übersicht: Produkt wechseln, Text von vorn.
      document.querySelectorAll<HTMLElement>('[data-goto]').forEach((btn) => {
        btn.addEventListener('click', () => {
          setActive(btn.dataset.goto!);
          stream.scrollTop = 0;
          scrollToSectionTop();
        });
      });
    }

    // ---------------------------------------------------------------------
    // Mobile: Der Text steht normal in der Seite, Wischen scrollt einfach weiter
    // bis zur Fußzeile. Umschalten NUR durch Antippen eines Namens in der Leiste.
    // ---------------------------------------------------------------------
    if (section && mCats.size) {
      const MDUR = reduceMotion ? 0 : 260;
      const mSlugs = Array.from(mCats.keys());
      navItems.forEach((li, slug) => {
        li.querySelector<HTMLElement>('[data-mgoto]')?.addEventListener('click', () => {
          if (slug === lastActive) {
            scrollToSectionTop();
            return;
          }
          const dir = mSlugs.indexOf(slug) > mSlugs.indexOf(lastActive) ? 1 : -1;
          animateSwap(mCats, lastActive, slug, dir, 32, MDUR, scrollToSectionTop);
        });
      });
    }
  }
</script>
