---
import { productCategories } from '../content/produkteTechnik';

const dtClass = 'font-mono text-xs uppercase tracking-[0.1em] text-slate-600';
---

<section id="produkte-technik" class="scroll-mt-[calc(var(--sg-header-h)+1rem)] bg-fog-50 pt-[var(--sg-header-h)] lg:pt-24">
  <h1 class="sr-only">Produkte und Technik — Silo-, Sole- und Automatisierungssysteme</h1>

  {/* MOBILE: schlanke, klebende Produktnamen-Leiste (nur Namen, links-rechts wischbar) */}
  <div class="pt-mbar lg:hidden">
    <ol class="pt-mnav">
      <li class="pt-mnav__spacer" aria-hidden="true"></li>
      {
        productCategories.map((c, i) => (
          <li class:list={['pt-mnav__item', i === 0 && 'is-active']} data-mnav={c.slug}>
            <button
              type="button"
              class="pt-mnav__btn font-display"
              data-mgoto={c.slug}
              aria-label={`${c.name} anzeigen`}
            >
              <span class="pt-mnav__index font-mono tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <span class="pt-mnav__label">{c.name}</span>
            </button>
          </li>
        ))
      }
      <li class="pt-mnav__spacer" aria-hidden="true"></li>
    </ol>
  </div>

  <div class="mx-auto max-w-6xl px-6">
    {/* MOBILE: bildschirmhoher Bereich, nur das aktive Produkt (Specs → Text) */}
    <div class="pt-mstage lg:hidden">
      {
        productCategories.map((c, i) => (
          <div class:list={['pt-mcat', i === 0 && 'is-shown']} data-mcat={c.slug}>
            <h2 class="sr-only">{c.name}</h2>
            {c.specs.length > 0 && (
              <dl class="pt-mspecs">
                {c.specs.map((s) => (
                  <div class="pt-mspecs__row">
                    <dt class={dtClass}>{s.label}</dt>
                    <dd class="mt-1 break-words text-sm leading-relaxed text-navy-900">{s.value}</dd>
                  </div>
                ))}
              </dl>
            )}
            <div class="space-y-4 text-base leading-relaxed text-slate-600 text-justify hyphens-auto">
              <p>{c.intro}</p>
              {c.paragraphs.map((t) => (
                <p>{t}</p>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    {/* DESKTOP: zweispaltig — links Umschalter, rechts der aktive Text (Stepped-Scrolling) */}
    <div class="hidden lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-10 xl:gap-16">
      {/* RECHTS (order-2): nur der aktive Kategorie-Text */}
      <div class="pt-stream lg:order-2">
        {
          productCategories.map((c, i) => (
            <div class:list={['pt-cat pt-2 pb-14 sm:pb-16', i === 0 && 'is-shown']} data-cat={c.slug} id={`cat-${c.slug}`}>
              <div class="pt-inner">
                <div class="space-y-4 text-base leading-relaxed text-slate-600 text-justify hyphens-auto">
                  <p>{c.intro}</p>
                  {c.paragraphs.map((t) => (
                    <p>{t}</p>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>

      {/* LINKS (order-1): Übersicht (Kategorie-Umschalter), oben startend */}
      <aside class="pt-panel lg:order-1">
        <div class="sticky top-24">
          <p class="mb-5 flex items-center gap-3 font-mono text-xs uppercase tracking-[0.14em] text-slate-600">
            <span class="inline-block h-px w-6 bg-copper-500"></span>
            Produkte &amp; Technik
          </p>
          <ol class="pt-switch border-t border-line">
            {
              productCategories.map((c, i) => (
                <li class:list={['pt-switch__item border-b border-line', i === 0 && 'is-active']} data-target={c.slug}>
                  <button type="button" class="pt-switch__name" data-goto={c.slug} aria-label={`Zu ${c.name} springen`}>
                    <span class="pt-switch__index font-mono text-xs tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                    <span class="pt-switch__label font-display text-xl font-semibold">{c.name}</span>
                  </button>
                  <div class="pt-switch__wrap">
                    <div class="pt-switch__info">
                      <p class="text-sm leading-relaxed text-slate-600">{c.tagline}</p>
                      {c.specs.length > 0 && (
                        <dl class="mt-3 divide-y divide-line border-t border-line">
                          {c.specs.map((s) => (
                            <div class="py-2.5">
                              <dt class={dtClass}>{s.label}</dt>
                              <dd class="mt-1 break-words text-sm leading-relaxed text-navy-900">{s.value}</dd>
                            </div>
                          ))}
                        </dl>
                      )}
                    </div>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  :where(.pt-stream, .pt-panel) {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* Höhe der mobilen Namensleiste — ein Ort zum Feintunen. */
  .pt-mbar,
  .pt-mstage {
    --pt-bar-h: 4.25rem;
  }

  /* --- Mobile: schlanke, klebende Produktnamen-Leiste --- */
  .pt-mbar {
    position: sticky;
    top: 4.75rem; /* direkt unter der fixierten Kopfzeile */
    z-index: 20;
    height: var(--pt-bar-h);
    background: color-mix(in srgb, var(--color-slate-500) 10%, var(--color-fog-50));
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .pt-mnav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    /* Kein Snapping — sonst würde der letzte Reiter beim Loslassen immer in die
       Mitte zurückgezogen und ließe sich nicht frei nach links schieben. */
    scroll-snap-type: none;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }
  .pt-mnav::-webkit-scrollbar {
    display: none;
  }
  /* Echte Spacer (zuverlässiger als ::before/::after), damit auch das erste und
     das letzte Element mittig in die Leiste gefahren werden können. */
  .pt-mnav__spacer {
    /* Startwert; per JS exakt auf „erster/letzter Reiter mittig" gesetzt. */
    flex: 0 0 45vw;
    align-self: stretch;
    pointer-events: none;
  }
  .pt-mnav__item {
    flex: 0 0 auto;
    scroll-snap-align: center;
  }
  .pt-mnav__btn {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.35rem 0;
    white-space: nowrap;
    cursor: pointer;
  }
  .pt-mnav__index {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--color-copper-500);
  }
  .pt-mnav__label {
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-slate-500);
    /* Senkrechter Trennstrich zwischen Nummer und Text — so hoch wie die
       Textzeile, skaliert automatisch mit (aktiv = größer). */
    border-left: 1px solid var(--color-line);
    padding-left: 0.4rem;
    transition:
      color 0.2s ease,
      font-size 0.2s ease;
  }
  /* Aktuell ausgewähltes Produkt größer + kupfern. */
  .pt-mnav__item.is-active .pt-mnav__label {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-copper-600);
  }
  .pt-mnav__item.is-active .pt-mnav__index {
    color: var(--color-copper-600);
  }
  .pt-mnav__btn:focus-visible {
    outline: 2px solid var(--color-copper-500);
    outline-offset: 2px;
  }

  /* --- Mobile: bildschirmhoher Scrollbereich, nur das aktive Produkt --- */
  .pt-mstage {
    height: calc(100dvh - 4.75rem - var(--pt-bar-h));
    overflow-y: auto;
    overscroll-behavior-y: contain; /* verhindert Durchrutschen auf die Seite */
    touch-action: pan-y;
    scrollbar-width: none;
  }
  .pt-mstage::-webkit-scrollbar {
    display: none;
  }
  .pt-mcat {
    display: none;
  }
  .pt-mcat.is-shown {
    display: block;
    padding-top: 1.25rem;
    padding-bottom: 2rem;
  }
  .pt-mspecs {
    margin: 0 0 1.5rem;
    border-top: 1px solid var(--color-line);
  }
  .pt-mspecs__row {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  /* --- Desktop: nur der aktive Kategorie-Text --- */
  .pt-inner {
    max-width: 44rem;
    margin-inline: auto;
  }
  .pt-cat {
    display: none;
  }
  .pt-cat.is-shown {
    display: block;
  }
  /* Desktop: nur der aktive Text, eigener Scrollbereich. */
  @media (min-width: 1024px) {
    .pt-stream {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      height: calc(100vh - 6rem);
      overflow-y: auto;
      scrollbar-width: thin;
      /* Versatz, damit der Textanfang auf Höhe des ersten Listeneintrags „01" liegt. */
      padding-top: 2.75rem;
    }
  }

  /* --- Desktop-Panel: Überschriften größer + orange --- */
  .pt-switch__item {
    padding-inline: 0.85rem;
    margin-inline: -0.85rem;
    border-radius: 2px;
  }
  .pt-switch__name {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    width: 100%;
    padding: 0.85rem 0;
    text-align: left;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }
  .pt-switch__item.is-active .pt-switch__name {
    opacity: 1;
  }
  .pt-switch__index {
    color: var(--color-copper-500);
  }
  .pt-switch__label {
    line-height: 1.2;
    color: var(--color-copper-500);
    position: relative;
  }
  .pt-switch__item.is-active .pt-switch__label {
    color: var(--color-copper-600);
  }
  .pt-switch__name:focus-visible {
    outline: 2px solid var(--color-copper-500);
    outline-offset: 2px;
  }
  .pt-switch__item.is-active .pt-switch__label::before {
    content: '';
    position: absolute;
    left: -0.75rem;
    top: 0.15em;
    bottom: 0.15em;
    width: 2px;
    background: var(--color-copper-500);
  }
  .pt-switch__wrap {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.4s var(--ease-out),
      opacity 0.3s ease;
  }
  .pt-switch__wrap > .pt-switch__info {
    overflow: hidden;
    min-height: 0;
  }
  .pt-switch__item.is-active .pt-switch__wrap {
    grid-template-rows: 1fr;
    opacity: 1;
    padding-bottom: 0.9rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .pt-switch__wrap {
      transition: opacity 0.2s ease;
    }
  }
</style>

<script>
  // -------------------------------------------------------------------------
  // Desktop: rechts (aktiver) Kategorie-Text, links Umschalter mit gesteuertem
  //          „Stepped Scrolling" (wheel).
  // Mobile:  oben schlanke Namensleiste, darunter ein bildschirmhoher Bereich,
  //          in dem nur das aktive Produkt steht (Specs → Text). Innerhalb frei
  //          scrollen; am Text-Ende/-Anfang springt es HART auf den Textanfang
  //          des nächsten/vorigen Produkts — kein durchgehendes Scrollen.
  // -------------------------------------------------------------------------
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Desktop-Umschalter + Textblöcke.
  const switchItems = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('.pt-switch__item').forEach((li) => {
    switchItems.set(li.dataset.target!, li);
  });
  const catBlocks = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('.pt-cat').forEach((b) => catBlocks.set(b.dataset.cat!, b));

  // Mobile-Namensleiste + Produkt-Blöcke.
  const navItems = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('.pt-mnav__item').forEach((li) => navItems.set(li.dataset.mnav!, li));
  const mCats = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('.pt-mcat').forEach((b) => mCats.set(b.dataset.mcat!, b));
  const nav = document.querySelector<HTMLElement>('.pt-mnav');
  const mStage = document.querySelector<HTMLElement>('.pt-mstage');

  // Aktiven Namen in der mobilen Leiste exakt mittig fahren (auf Desktop No-Op,
  // da versteckt). Zweiter Lauf nach dem Größer-Werden (font-size-Übergang des
  // aktiven Reiters), damit die Breite final gemessen und sauber zentriert wird.
  const centerNav = (slug: string) => {
    const li = navItems.get(slug);
    if (!li || !nav || nav.offsetParent === null) return;
    const doCenter = () => {
      const left = li.offsetLeft - (nav.clientWidth - li.clientWidth) / 2;
      nav.scrollTo({ left, behavior: reduceMotion ? 'auto' : 'smooth' });
    };
    doCenter();
    window.setTimeout(doCenter, 240);
  };

  // Aktive (vergrößerte) Breite eines Reiters messen — Transition kurz aus, damit
  // sofort die Endbreite gemessen wird, nicht ein Zwischenwert.
  const activeWidth = (li: HTMLElement): number => {
    const label = li.querySelector<HTMLElement>('.pt-mnav__label');
    const prevT = label?.style.transition ?? '';
    if (label) label.style.transition = 'none';
    const was = li.classList.contains('is-active');
    if (!was) li.classList.add('is-active');
    const w = li.getBoundingClientRect().width;
    if (!was) li.classList.remove('is-active');
    if (label) label.style.transition = prevT;
    return w;
  };

  // Spacer exakt so breit, dass der erste bzw. letzte Reiter GENAU mittig steht —
  // nicht breiter (sonst ließe es sich zu weit ins Leere schieben).
  const sizeSpacers = () => {
    if (!nav || nav.offsetParent === null) return;
    const items = Array.from(navItems.values());
    if (!items.length) return;
    const navW = nav.clientWidth;
    const spacers = nav.querySelectorAll<HTMLElement>('.pt-mnav__spacer');
    if (spacers[0]) spacers[0].style.flexBasis = `${Math.max(0, (navW - activeWidth(items[0])) / 2)}px`;
    if (spacers[1])
      spacers[1].style.flexBasis = `${Math.max(0, (navW - activeWidth(items[items.length - 1])) / 2)}px`;
    if (lastActive) centerNav(lastActive);
  };
  if (nav) {
    requestAnimationFrame(sizeSpacers);
    window.addEventListener('resize', sizeSpacers);
    document.fonts?.ready.then(sizeSpacers);
  }

  let lastActive = '';
  const setActive = (slug: string) => {
    if (slug === lastActive) return;
    lastActive = slug;
    switchItems.forEach((li, s) => li.classList.toggle('is-active', s === slug));
    navItems.forEach((li, s) => li.classList.toggle('is-active', s === slug));
    catBlocks.forEach((b, s) => b.classList.toggle('is-shown', s === slug));
    mCats.forEach((b, s) => b.classList.toggle('is-shown', s === slug));
    centerNav(slug);
  };

  const firstSlug = document.querySelector<HTMLElement>('.pt-cat')?.dataset.cat;
  if (firstSlug) {
    setActive(firstSlug);

    const stream = document.querySelector<HTMLElement>('.pt-stream');
    const section = document.getElementById('produkte-technik');
    const slugs = Array.from(catBlocks.keys());
    const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;

    // Gemeinsame Slide-Animation: aktueller Block fährt raus, danach neuer rein.
    const animateSwap = (
      blocks: Map<string, HTMLElement>,
      fromSlug: string,
      toSlug: string,
      dir: number,
      dist: number,
      dur: number,
      afterHide: () => void,
    ) => {
      const cur = blocks.get(fromSlug);
      if (cur && !reduceMotion) {
        cur.style.transition = `transform ${dur}ms ease, opacity ${dur}ms ease`;
        cur.style.transform = `translateY(${dir > 0 ? -dist : dist}px)`;
        cur.style.opacity = '0';
      }
      window.setTimeout(
        () => {
          if (cur) {
            cur.style.transition = '';
            cur.style.transform = '';
            cur.style.opacity = '';
          }
          setActive(toSlug);
          afterHide();
          const nxt = blocks.get(toSlug);
          if (nxt && !reduceMotion) {
            nxt.style.transition = 'none';
            nxt.style.transform = `translateY(${dir > 0 ? dist * 0.5 : -dist * 0.5}px)`;
            nxt.style.opacity = '0';
            requestAnimationFrame(() => {
              nxt.style.transition = `transform ${dur}ms ease, opacity ${dur}ms ease`;
              nxt.style.transform = '';
              nxt.style.opacity = '';
              window.setTimeout(() => (nxt.style.transition = ''), dur + 30);
            });
          }
        },
        reduceMotion ? 0 : dur,
      );
    };

    // ---------------------------------------------------------------------
    // Desktop: gesteuertes „Stepped Scrolling" (wheel).
    // ---------------------------------------------------------------------
    if (stream && section) {
      const DUR = reduceMotion ? 0 : 240;
      // Umschalt-Modell (Transform statt Nativ-Scroll): Der aktive Text wird per
      // translateY verschoben — auch wenn er kürzer als der sichtbare Bereich ist.
      //   • RUNTER scrollen: Text schiebt sich nach OBEN, bis die erste Zeile an der
      //     Kopfzeile ankommt (offset === maxOffset) → nächstes Produkt, das oben
      //     (offset 0) einsteigt.
      //   • RAUF scrollen: Text schiebt sich nach UNTEN, bis die letzte Zeile am
      //     unteren Bildschirmrand ankommt (offset === minOffset) → voriges Produkt,
      //     das MITTIG (offset === centerOffset, mit Mindestabstand zur Kopfzeile)
      //     einsteigt.
      // Eine Geste schaltet höchstens EIN Produkt weiter (Cooldown).
      stream.style.overflow = 'hidden'; // verschobener Text wird oben/unten abgeschnitten

      const MIN_HEADER_GAP = 40; // Mindestabstand der ersten Zeile zur Kopfzeile (mittig)
      let cooling = false;
      let coolTimer = 0;
      let offset = 0; // Verschiebung des aktiven Textes (px; >0 = nach oben)
      let maxOffset = 0; // bis erste Zeile an der Kopfzeile (Runter-Umschaltpunkt)
      let minOffset = 0; // bis letzte Zeile am unteren Rand (Rauf-Umschaltpunkt; i. d. R. < 0)
      let centerOffset = 0; // mittige Einstiegsposition beim Hochscrollen
      const holdCooling = () => {
        clearTimeout(coolTimer);
        coolTimer = window.setTimeout(() => (cooling = false), 240);
      };

      const header = document.querySelector('header');
      // Alle Grenz-Offsets ohne aktuellen Transform messen (transform kurz auf none).
      const measure = (el: HTMLElement) => {
        const prev = el.style.transform;
        el.style.transform = 'none';
        const rect = el.getBoundingClientRect();
        el.style.transform = prev;
        const headerBottom = header ? header.getBoundingClientRect().bottom : 0;
        const streamBottom = stream.getBoundingClientRect().bottom;

        // Runter: erste Zeile an die Kopfzeile (bei hohen Texten: bis Ende sichtbar).
        const gap = rect.top - headerBottom;
        const belowFold = rect.bottom - streamBottom;
        maxOffset = Math.max(Math.round(Math.max(gap, belowFold)), 40);

        // Rauf: letzte Zeile an den unteren Rand (nie über die Top-Position hinaus).
        minOffset = Math.min(Math.round(rect.bottom - streamBottom), 0);

        // Mittig, aber erste Zeile nie näher als MIN_HEADER_GAP an der Kopfzeile.
        let center = (rect.top + rect.bottom) / 2 - (headerBottom + streamBottom) / 2;
        center = Math.min(center, rect.top - headerBottom - MIN_HEADER_GAP);
        centerOffset = Math.max(Math.min(Math.round(center), maxOffset), minOffset);
      };
      const applyOffset = () => {
        const el = catBlocks.get(lastActive);
        if (el) el.style.transform = `translateY(${-offset}px)`;
      };
      const recalc = () => {
        const el = catBlocks.get(lastActive);
        if (el) measure(el);
      };

      // Neues Produkt einblenden: runter (dir>0) am Textanfang (offset 0), rauf
      // (dir<0) mittig (offset centerOffset), plus kleine Einblend-Bewegung.
      const enter = (slug: string, dir: number) => {
        setActive(slug);
        recalc();
        offset = dir > 0 ? 0 : centerOffset;
        const el = catBlocks.get(slug);
        if (!el) return;
        if (reduceMotion) {
          applyOffset();
          return;
        }
        el.style.transition = 'none';
        el.style.transform = `translateY(${-offset + (dir > 0 ? 26 : -26)}px)`;
        el.style.opacity = '0';
        requestAnimationFrame(() => {
          el.style.transition = `transform ${DUR}ms ease, opacity ${DUR}ms ease`;
          applyOffset();
          el.style.opacity = '1';
          window.setTimeout(() => (el.style.transition = ''), DUR + 30);
        });
      };

      const step = (dir: number) => {
        const idx = slugs.indexOf(lastActive);
        const ni = idx + dir;
        if (ni < 0 || ni >= slugs.length) return;
        cooling = true;
        holdCooling();
        enter(slugs[ni], dir);
      };

      // Startzustand.
      recalc();
      applyOffset();
      window.addEventListener('resize', () => {
        recalc();
        offset = Math.max(Math.min(offset, maxOffset), minOffset);
        applyOffset();
      });

      section.addEventListener(
        'wheel',
        (e) => {
          if (!isDesktop()) return;
          if (cooling) {
            e.preventDefault();
            holdCooling();
            return;
          }
          const pinned = Math.abs(section.getBoundingClientRect().top) < 4;
          if (!pinned) {
            e.preventDefault();
            window.scrollBy(0, e.deltaY);
            return;
          }
          const idx = slugs.indexOf(lastActive);

          if (e.deltaY > 0) {
            // Text noch nicht ganz oben → weiter nach oben schieben.
            if (offset < maxOffset) {
              e.preventDefault();
              offset = Math.min(maxOffset, offset + e.deltaY);
              applyOffset();
              return;
            }
            // Erste Zeile an der Kopfzeile → nächstes Produkt (sonst Seite weiter).
            if (idx >= slugs.length - 1) return;
            e.preventDefault();
            step(1);
          } else if (e.deltaY < 0) {
            // Text noch nicht ganz unten → weiter nach unten schieben.
            if (offset > minOffset) {
              e.preventDefault();
              offset = Math.max(minOffset, offset + e.deltaY); // deltaY negativ
              applyOffset();
              return;
            }
            // Letzte Zeile am unteren Rand → voriges Produkt (sonst Seite zurück).
            if (idx <= 0) return;
            e.preventDefault();
            step(-1);
          }
        },
        { passive: false },
      );

      // Desktop-Umschalter (Klick in der Übersicht): direkt zum Text-Anfang.
      document.querySelectorAll<HTMLElement>('[data-goto]').forEach((btn) => {
        btn.addEventListener('click', () => {
          setActive(btn.dataset.goto!);
          recalc();
          offset = 0;
          applyOffset();
          section?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
        });
      });
    }

    // ---------------------------------------------------------------------
    // Mobile: Stepped Scrolling per Touch im bildschirmhohen Bereich.
    // ---------------------------------------------------------------------
    if (mStage && section && mCats.size) {
      const MDUR = reduceMotion ? 0 : 260;
      const mSlugs = Array.from(mCats.keys());
      let mCooling = false;
      let mCoolTimer = 0;
      const holdM = () => {
        clearTimeout(mCoolTimer);
        mCoolTimer = window.setTimeout(() => (mCooling = false), 200);
      };

      // Immer am Textanfang des Zielprodukts landen (kein Zwischenzustand).
      const mStep = (dir: number) => {
        const idx = mSlugs.indexOf(lastActive);
        const ni = idx + dir;
        if (ni < 0 || ni >= mSlugs.length) return;
        mCooling = true;
        holdM();
        animateSwap(mCats, lastActive, mSlugs[ni], dir, 32, MDUR, () => {
          mStage.scrollTop = 0;
        });
      };

      // Nach dem letzten Produkt eine Wisch-Geste → ganz ans Seitenende scrollen.
      const releaseDown = () => {
        mCooling = true;
        holdM();
        const bottom = Math.max(document.documentElement.scrollHeight, document.body.scrollHeight);
        window.scrollTo({ top: bottom, behavior: reduceMotion ? 'auto' : 'smooth' });
      };

      let prevY = 0;
      mStage.addEventListener(
        'touchstart',
        (e) => {
          prevY = e.touches[0].clientY;
        },
        { passive: true },
      );
      mStage.addEventListener(
        'touchmove',
        (e) => {
          if (isDesktop()) return;
          if (mCooling) {
            e.preventDefault();
            return;
          }
          const y = e.touches[0].clientY;
          const dy = prevY - y; // > 0 = nach oben wischen (weiter/nächstes)
          prevY = y;
          const atTop = mStage.scrollTop <= 0;
          const atBottom = mStage.scrollTop + mStage.clientHeight >= mStage.scrollHeight - 1;
          const idx = mSlugs.indexOf(lastActive);
          if (dy > 2 && atBottom) {
            if (idx < mSlugs.length - 1) {
              e.preventDefault();
              mStep(1);
            } else {
              e.preventDefault();
              releaseDown();
            }
          } else if (dy < -2 && atTop && idx > 0) {
            e.preventDefault();
            mStep(-1);
          }
          // sonst: normal im Produkt scrollen (nativ)
        },
        { passive: false },
      );

      // Gleiche Rand-Logik für Maus/Trackpad (z. B. DevTools-Mobilansicht),
      // da dort wheel- statt touch-Events kommen.
      mStage.addEventListener(
        'wheel',
        (e) => {
          if (isDesktop()) return;
          if (mCooling) {
            e.preventDefault();
            return;
          }
          const atTop = mStage.scrollTop <= 0;
          const atBottom = mStage.scrollTop + mStage.clientHeight >= mStage.scrollHeight - 1;
          const idx = mSlugs.indexOf(lastActive);
          if (e.deltaY > 0 && atBottom) {
            if (idx < mSlugs.length - 1) {
              e.preventDefault();
              mStep(1);
            } else {
              e.preventDefault();
              releaseDown();
            }
          } else if (e.deltaY < 0 && atTop && idx > 0) {
            e.preventDefault();
            mStep(-1);
          }
          // sonst: normal im Produkt scrollen (nativ)
        },
        { passive: false },
      );

      // Namen antippen → hart auf den Textanfang dieses Produkts.
      navItems.forEach((li, slug) => {
        li.querySelector<HTMLElement>('[data-mgoto]')?.addEventListener('click', () => {
          if (slug === lastActive) {
            mStage.scrollTop = 0;
            return;
          }
          const dir = mSlugs.indexOf(slug) > mSlugs.indexOf(lastActive) ? 1 : -1;
          mCooling = true;
          holdM();
          animateSwap(mCats, lastActive, slug, dir, 32, MDUR, () => {
            mStage.scrollTop = 0;
          });
        });
      });
    }
  }
</script>
