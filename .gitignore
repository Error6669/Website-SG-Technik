# build output
dist/
.astro/

# dependencies
node_modules/

# environment
.env
.env.production

# macOS
.DS_Store

# editor
.vscode/*
!.vscode/extensions.json

# local Claude Code settings (machine-specific, not shared)
.claude/settings.local.json

# original source briefing docs (internal, not for the public repo)
Aufbau Website 2.0.docx
~$fbau Website 2.0.docx
Website-Struktur_SG_Technik_GmbH.csv

# Verarbeitungsverzeichnis nach Art. 30 DSGVO — internes Geschäftsdokument mit
# Angaben zu eingesetzten Systemen und Zugriffsberechtigten. Gehört in die
# Firmenablage, nicht ins Repository. (PRIVACY-CHECKLIST.md bleibt versioniert.)
Verarbeitungsverzeichnis_SG_Technik_GmbH*.xlsx

# temporäre Sperrdateien von Excel/Word
~$*

# original project photos/videos (large source files, ~270 MB incl. .mov videos);
# optimized web copies live in src/assets/referenzen/ and are committed
Fotos/

# Animations-Prototypen (lokale Spielwiese, ~10 MB — die HTML-Dateien tragen
# ihre Bilder als Base64 im Rumpf). Nicht versionieren.
Animationen/

# Firmenbuchauszüge (FN 624545 z). Enthalten Geburtsdaten und Privatadressen
# der Geschäftsführer sowie Gesellschafteranteile — personenbezogene Daten, die
# nicht ins Repository gehören. Die daraus übernommenen Pflichtangaben stehen in
# src/content/legal.ts. Auszüge in der Firmenablage aufbewahren.
FB_*.pdf

# Heruntergeladene Gesetzestexte (RIS/EUR-Lex) als Beleg zu den Rechtsseiten,
# ~16 MB Fremddokumente — nicht versionieren, bei Bedarf neu laden.
# Die README ist davon ausgenommen: sie ordnet jeden Gesetzesverweis im Code
# seiner Fundstelle zu und enthält die Anleitung zum Neuladen. Sie muss im Repo
# bleiben, sonst ist die Zuordnung nur lokal vorhanden.
Rechtstexte/*
!Rechtstexte/README.md
