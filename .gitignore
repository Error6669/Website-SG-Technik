# build output
dist/
.astro/

# dependencies
node_modules/

# environment
.env
.env.production

# macOS
.DS_Store

# editor
.vscode/*
!.vscode/extensions.json

# local Claude Code settings (machine-specific, not shared)
.claude/settings.local.json

# Firmen- und Briefingdokumente (Unterlagen/): Original-Briefing, Seitenstruktur
# und das Verarbeitungsverzeichnis nach Art. 30 DSGVO. Enthalten interne Angaben
# zu Systemen, Zugriffsberechtigten und Dienstnehmern und gehoeren nicht ins
# Repository. Die README bleibt versioniert, damit nachvollziehbar ist, was dort
# liegt. (PRIVACY-CHECKLIST.md bleibt ebenfalls versioniert.)
Unterlagen/*
!Unterlagen/README.md

# Angebote aus der Firmenablage (01_Projekte/00_Angebote), lokal zum Auslesen
# der Auftraggeber für die Referenzen. Interne Kunden- und Preisangaben, nicht
# ins Repository.
00_Angebote/

# temporäre Sperrdateien von Excel/Word
~$*

# original project photos/videos (large source files, ~270 MB incl. .mov videos);
# optimized web copies live in src/assets/referenzen/ and are committed
Fotos/

# Animations-Prototypen (lokale Spielwiese, ~10 MB — die HTML-Dateien tragen
# ihre Bilder als Base64 im Rumpf). Nicht versionieren.
Animationen/

# Firmenbuchauszüge (FN 624545 z). Enthalten Geburtsdaten und Privatadressen
# der Geschäftsführer sowie Gesellschafteranteile — personenbezogene Daten, die
# nicht ins Repository gehören. Die daraus übernommenen Pflichtangaben stehen in
# src/content/legal.ts. Auszüge in der Firmenablage aufbewahren.
FB_*.pdf

# Heruntergeladene Gesetzestexte (RIS/EUR-Lex) als Beleg zu den Rechtsseiten,
# ~16 MB Fremddokumente — nicht versionieren, bei Bedarf neu laden.
# Die README ist davon ausgenommen: sie ordnet jeden Gesetzesverweis im Code
# seiner Fundstelle zu und enthält die Anleitung zum Neuladen. Sie muss im Repo
# bleiben, sonst ist die Zuordnung nur lokal vorhanden.
Rechtstexte/*
!Rechtstexte/README.md

# Heruntergeladene Nachweisdokumente zur Datenschutz-Freigabe (Microsoft-DPA
# u. a., je ~6 MB). Durchgangsstation auf dem Weg in die Nachweismappe der
# Firmenablage, nicht ins Repository. Die README bleibt versioniert: sie haelt
# Quelle, Fassung und Abrufdatum jedes Dokuments fest.
Nachweise/*
!Nachweise/README.md
